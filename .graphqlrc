schema: "https://production.unified.apis.holi.social/graphql"
extensions:
  graphql-markdown:
    rootPath: "./docs"
    linkRoot: "/docs"
    baseURL: "graphql"
    homepage: "docs/graphql/index.mdx"
    loaders:
      UrlLoader:
        module: "@graphql-tools/url-loader"
        options:
          method: "POST"
    printTypeOptions:
      deprecated: "default"
    docOptions:
      pagination: false,
      toc: false