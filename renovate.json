{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":configMigration",
    ":enableVulnerabilityAlertsWithLabel('renovatebot/security')",
    ":semanticCommits",
    ":automergePatch",
    ":automergeTesters",
    ":automergeLinters"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "npm"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true
    }
  ]
}